      "import": "./dist/esm/communityM/node/index.js",
      "require": "./dist/cjs/communityM/node/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "ffexpr": [
        "dist/types/ffexpr/index.d.ts"
      ],
      "mosaic/flatten": [
        "dist/types/mosaic/flatten/index.d.ts"
      ],
      "mosaic/validate": [
        "dist/types/mosaic/validate/index.d.ts"
      ],
      "mosaic/loadMosaicDocument": [
        "dist/types/mosaic/loadMosaicDocument.d.ts"
      ],
      "mosaic/serializeMosaicDocument": [
        "dist/types/mosaic/serializeMosaicDocument.d.ts"
      ],
      "share": [
        "dist/types/share/index.d.ts"
      ],
      "template-repos": [
        "dist/types/template-repos/index.d.ts"
      ],
      "media": [
        "dist/types/media/index.d.ts"
      ],
      "toolchain": [
        "dist/types/toolchain/index.d.ts"
      ],
      "toolchain/ffmpeg": [
        "dist/types/toolchain/ffmpeg/index.d.ts"
      ],
      "toolchain/ffmpeg/install": [
        "dist/types/toolchain/ffmpeg/install.d.ts"
      ],
      "toolchain/versionCompare": [
        "dist/types/toolchain/versionCompare.d.ts"
      ],
      "paths": [
        "dist/types/paths/index.d.ts"
      ],
      "output": [
        "dist/types/output/index.d.ts"
      ],
      "secrets": [
        "dist/types/secrets/index.d.ts"
      ],
      "host-connections": [
        "dist/types/host-connections/index.d.ts"
      ],
      "system": [
        "dist/types/system/index.d.ts"
      ],
      "telemetry": [
        "dist/types/telemetry/index.d.ts"
      ],
      "communityM/node": [
        "dist/types/communityM/node/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:types && npm run build:esm && npm run build:cjs",
    "build:types": "tsc -p tsconfig.types.json",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/fix-esm-imports.js && node -e \"require('fs').writeFileSync('dist/esm/package.json','{\\\"type\\\":\\\"module\\\"}\\n')\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "test": "npm run test:jest && npm run test:node",
    "test:jest": "jest",
    "test:node": "node --test __tests__/templateRepoReload.test.js"
  },
  "dependencies": {
    "@m0saic/dsl": "^2.0.0",
    "@m0saic/dsl-stdlib": "^3.0.0",
    "@m0saic/types": "^0.2.0"
  }
}
