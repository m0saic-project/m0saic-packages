{
  "name": "@m0saic/platform",
  "version": "0.2.0",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m0saic-project/m0saic-packages.git",
    "directory": "packages/platform"
  },
  "homepage": "https://github.com/m0saic-project/m0saic-packages/tree/main/packages/platform#readme",
  "bugs": {
    "url": "https://github.com/m0saic-project/m0saic-packages/issues"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./ffexpr": {
      "types": "./dist/types/ffexpr/index.d.ts",
      "browser": "./dist/cjs/ffexpr/index.js",
      "import": "./dist/esm/ffexpr/index.js",
      "require": "./dist/cjs/ffexpr/index.js"
    },
    "./mosaic/flatten": {
