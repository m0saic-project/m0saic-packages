{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/cjs",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "declaration": false,
    "declarationMap": false
  },
  "exclude": ["**/*.test.ts", "**/*.spec.ts"]
}
