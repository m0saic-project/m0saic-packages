{
  "name": "@m0saic/templates",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m0saic-project/m0saic-packages.git",
    "directory": "packages/templates"
  },
  "homepage": "https://github.com/m0saic-project/m0saic-packages/tree/main/packages/templates#readme",
  "bugs": {
    "url": "https://github.com/m0saic-project/m0saic-packages/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist template-manifest.json web-template-ids.json",
    "build": "tsc -p tsconfig.json && node tools/copy-assets.mjs && node dist/gen-template-manifest.js && node dist/gen-web-template-ids.js && node tools/check-registry.mjs",
    "conventions:sweep": "node tools/check-registry.mjs --sweep",
    "fingerprints:update": "node tools/check-registry.mjs --update-fingerprints",
    "audit:templates": "node dist/gen-template-audit.js",
    "audit:precision-sweep": "node dist/gen-precision-sweep.js",
    "audit:geometry-matrix": "node dist/gen-geometry-matrix.js",
    "audit:geometry-proof": "node dist/gen-geometry-proof.js",
    "audit:layout-envelope": "node dist/gen-layout-envelope.js",
    "audit:props": "node dist/gen-props-shape.js",
    "test": "jest"
  },
  "dependencies": {
    "@m0saic/community-m": "^0.2.0",
    "@m0saic/dictionary": "^0.2.0",
    "@m0saic/dsl": "^2.0.0",
    "@m0saic/dsl-file-formats": "^2.0.0",
    "@m0saic/dsl-stdlib": "^3.0.0",
    "@m0saic/platform": "^0.2.0",
    "@m0saic/template-utils": "^0.2.0",
    "@m0saic/text": "^0.2.0",
    "@m0saic/types": "^0.2.0",
    "@resvg/resvg-wasm": "^2.6.2"
  },
  "files": [
    "dist",
    "template-manifest.json",
    "web-template-ids.json",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "rimraf": "^6.1.3"
  }
}
